<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DiGi.Maintenance.UI.Windows"
        xmlns:coreControls="clr-namespace:DiGi.UI.WPF.Core.Controls;assembly=DiGi.UI.WPF.Core"
        xmlns:controls="clr-namespace:DiGi.Maintenance.UI.Controls" x:Class="DiGi.Maintenance.UI.Windows.SolutionsWindow"
        mc:Ignorable="d"
        Title="SolutionsWindow" Height="450" Width="500" Loaded="Window_Loaded">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" MinWidth="200" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" MinWidth="200" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Left panel content -->
        <Grid Grid.Column="0">
            <coreControls:ListBoxControl x:Name="ListBoxControl_Solutions" Margin="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
        </Grid>

        <!-- Splitter between columns -->
        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ShowsPreview="True" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" />

        <!-- Right panel content -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="140" />
            </Grid.RowDefinitions>

            <controls:SolutionControl x:Name="SolutionControl_Main" Grid.Row="0" HorizontalAlignment="Stretch" Margin="5,5,5,5" VerticalAlignment="Stretch" />

            <StackPanel Grid.Row="1" Orientation="Vertical" HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="5,5,5,5">
                <Button x:Name="Button_Load" Content="Load" HorizontalAlignment="Stretch" Margin="0,0,0,5" Click="Button_Load_Click" />
                <Button x:Name="Button_UpdateSolution" Content="Update Solution" HorizontalAlignment="Stretch" Margin="0,0,0,5" Click="Button_UpdateSolution_Click" />
                <Button x:Name="Button_Sync" Content="Sync with GitHub" HorizontalAlignment="Stretch" Margin="0,0,0,5" Click="Button_Sync_Click" />
                <Button x:Name="Button_CleanDirectories" Content="Clean Directories" HorizontalAlignment="Stretch" Margin="0,0,0,5" Click="Button_CleanDirectories_Click" />
                <Button x:Name="Button_Test" Content="Test" HorizontalAlignment="Stretch" Margin="0,0,0,0" Click="Button_Test_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>